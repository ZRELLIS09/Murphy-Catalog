// Placeholder image generator — produces subtly striped SVG data URIs for
// products that don't yet have real photography. Deterministic per id.
window.MurphyPlaceholder = (function() {
  function hashHue(s) {
    let h = 0; for (let i=0;i<s.length;i++) h = (h*31 + s.charCodeAt(i)) | 0;
    return Math.abs(h);
  }
  function make(id, label, w, h) {
    w = w || 600; h = h || 400;
    const seed = hashHue(id || 'x');
    // Muted industrial tones, pulled from brand
    const palettes = [
      ['#F0EDE8', '#E0DCD4', '#8A867E'],
      ['#E8E4DD', '#D4CFC4', '#7A7469'],
      ['#EEECE5', '#DAD4C6', '#8C877A'],
      ['#F2EFE9', '#DCD6C8', '#847D6E'],
    ];
    const p = palettes[seed % palettes.length];
    const svg = `<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 ${w} ${h}' preserveAspectRatio='xMidYMid slice'>
      <defs>
        <pattern id='p${seed}' width='14' height='14' patternUnits='userSpaceOnUse' patternTransform='rotate(45)'>
          <rect width='14' height='14' fill='${p[0]}'/>
          <rect width='7' height='14' fill='${p[1]}'/>
        </pattern>
      </defs>
      <rect width='${w}' height='${h}' fill='url(#p${seed})'/>
      <rect x='16' y='16' width='${w-32}' height='${h-32}' fill='none' stroke='${p[2]}' stroke-width='1' stroke-dasharray='4 4' opacity='0.5'/>
      <g font-family='ui-monospace, Menlo, monospace' fill='${p[2]}' text-anchor='middle'>
        <text x='${w/2}' y='${h/2 - 6}' font-size='14' letter-spacing='2'>PRODUCT IMAGE</text>
        <text x='${w/2}' y='${h/2 + 16}' font-size='11' letter-spacing='1' opacity='0.75'>${(label || id || '').toUpperCase()}</text>
      </g>
    </svg>`;
    return 'data:image/svg+xml;utf8,' + encodeURIComponent(svg);
  }
  return { make };
})();
